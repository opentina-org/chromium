From: OpenTina Maintainers <maintainers@opentina.org>
Date: Wed, 25 Nov 2026 17:30:00 +0800
Subject: [PATCH] gpu: restore EGL OpenGL ES 3.0 -> 2.0 context fallback for ES2-only drivers

On embedded Linux GPU stacks where Mesa Zink over Vulkan currently exposes
OpenGL ES 2.0 without ES 3.0 (such as PowerVR Rogue/BXM via imagination +
zink in Mesa 26.1.x), ANGLE gles-egl initializes cleanly with max supported
client version 2.0 and rejects ES 3.0 eglCreateContext requests with
EGL_BAD_ATTRIBUTE ("Requested version is not supported").

Allow ES version fallback in gpu_info_collector::InitializeGLContext() so
startup GPU info collection succeeds on ES 2.0 hardware drivers while keeping
explicit WebGL2 context creation strict, and handle EGL_BAD_CONFIG as well as
non-configless EGL displays in GLContextEGL::InitializeImpl().
---
--- a/gpu/config/gpu_info_collector.cc
+++ b/gpu/config/gpu_info_collector.cc
@@ -91,7 +91,7 @@
 scoped_refptr<gl::GLContext> InitializeGLContext(gl::GLSurface* surface) {
   TRACE_EVENT("gpu,startup", "gpu_info_collector::InitializeGLContext");
   gl::GLContextAttribs attribs;
-  attribs.allow_es_version_fallback = false;
+  attribs.allow_es_version_fallback = true;
   scoped_refptr<gl::GLContext> context(
       gl::init::CreateGLContext(nullptr, surface, attribs));
   if (!context.get()) {
--- a/ui/gl/gl_context_egl.cc
+++ b/ui/gl/gl_context_egl.cc
@@ -367,20 +367,24 @@
     return false;
   }
 
-  // If EGL_KHR_no_config_context is in use and context creation failed,
-  // it might indicate that an unsupported ES version was requested. Try
-  // falling back to a lower version.
+  // If context creation failed, it might indicate that an unsupported ES
+  // version was requested. Try falling back to a lower version.
   GLint error = eglGetError();
   LOG(ERROR) << "eglCreateContext ES " << context_client_major_version << "."
              << context_client_minor_version << " failed with error "
              << GetEGLErrorString(error);
 
-  if (gl_display_->ext->b_EGL_KHR_no_config_context &&
-      (error == EGL_BAD_MATCH || error == EGL_BAD_ATTRIBUTE)) {
-    // Set up the list of versions to try: 3.1 -> 3.0 -> 2.0
+  if (error == EGL_BAD_MATCH || error == EGL_BAD_ATTRIBUTE ||
+      error == EGL_BAD_CONFIG) {
+    // Set up the list of versions to try: 3.2 -> 3.1 -> 3.0 -> 2.0
     std::vector<std::pair<EGLint, EGLint>> candidate_versions;
     if (context_client_major_version == 3 &&
-        context_client_minor_version == 1) {
+        context_client_minor_version >= 2) {
+      candidate_versions.emplace_back(3, 1);
+      candidate_versions.emplace_back(3, 0);
+      candidate_versions.emplace_back(2, 0);
+    } else if (context_client_major_version == 3 &&
+               context_client_minor_version == 1) {
       candidate_versions.emplace_back(3, 0);
       candidate_versions.emplace_back(2, 0);
     } else if (context_client_major_version == 3 &&
@@ -391,8 +395,10 @@
     for (const auto& version : candidate_versions) {
       if (!ChangeContextAttributes(context_attributes,
                                    EGL_CONTEXT_MAJOR_VERSION, version.first) ||
-          !ChangeContextAttributes(context_attributes,
-                                   EGL_CONTEXT_MINOR_VERSION, version.second)) {
+          (gl_display_->ext->b_EGL_KHR_create_context &&
+           !ChangeContextAttributes(context_attributes,
+                                    EGL_CONTEXT_MINOR_VERSION,
+                                    version.second))) {
         break;
       }
 
