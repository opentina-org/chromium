# OpenTina GPU defaults for ARM64 Mesa/Zink + Wayland/X11 sessions.
# Chromium 156 removed --ozone-platform-hint and only parses --ozone-platform.
# Scan combined ($CHROMIUM_FLAGS followed by "$@") up to the first '--'.

_ot_has_ozone=0
_ot_hint_platform=""
_ot_has_gl=0
_ot_seen_ddash=0

for _ot_tok in $CHROMIUM_FLAGS; do
  case "$_ot_tok" in
    --) _ot_seen_ddash=1; break ;;
    --ozone-platform=*) _ot_has_ozone=1 ;;
    --ozone-platform-hint=x11) _ot_hint_platform="x11" ;;
    --ozone-platform-hint=wayland) _ot_hint_platform="wayland" ;;
    --ozone-platform-hint=auto) _ot_hint_platform="auto" ;;
    --use-angle=*|--use-gl=*) _ot_has_gl=1 ;;
  esac
done

if [ "$_ot_seen_ddash" -eq 0 ]; then
  for _ot_arg in "$@"; do
    case "$_ot_arg" in
      --) break ;;
      --ozone-platform=*) _ot_has_ozone=1 ;;
      --ozone-platform-hint=x11) _ot_hint_platform="x11" ;;
      --ozone-platform-hint=wayland) _ot_hint_platform="wayland" ;;
      --ozone-platform-hint=auto) _ot_hint_platform="auto" ;;
      --use-angle=*|--use-gl=*) _ot_has_gl=1 ;;
    esac
  done
fi

_ot_prepend=""
if [ "$_ot_has_ozone" -eq 0 ]; then
  case "$_ot_hint_platform" in
    x11|wayland)
      _ot_prepend="$_ot_prepend --ozone-platform=$_ot_hint_platform"
      ;;
    *)
      if [ "${XDG_SESSION_TYPE:-}" = "wayland" ] || { [ -n "${WAYLAND_DISPLAY:-}" ] && [ -z "${DISPLAY:-}" ]; }; then
        _ot_prepend="$_ot_prepend --ozone-platform=wayland"
      fi
      ;;
  esac
fi

if [ "$_ot_has_gl" -eq 0 ]; then
  _ot_prepend="$_ot_prepend --use-angle=gles-egl"
fi

if [ -n "$_ot_prepend" ]; then
  # Prepend before CHROMIUM_FLAGS so any '--' inside CHROMIUM_FLAGS never turns
  # generated switches into positional arguments.
  CHROMIUM_FLAGS="${_ot_prepend# }${CHROMIUM_FLAGS:+ $CHROMIUM_FLAGS}"
fi

unset _ot_tok _ot_arg _ot_has_ozone _ot_hint_platform _ot_has_gl _ot_seen_ddash _ot_prepend
